# Postgres — Neon, Vercel Postgres, Supabase ou qualquer Postgres.
# Use a string "pooled" (com -pooler) quando o provedor oferecer.
DATABASE_URL='postgresql://usuario:senha@host/banco?sslmode=require'

# E-mail (opcional). Sem a chave, o sistema escreve a mensagem no log do
# servidor em vez de enviar — util para testar sem contratar nada.
RESEND_API_KEY=
EMAIL_FROM='Fornalha <nao-responda@seudominio.com.br>'

# Endereco publico, usado nos links dos e-mails. Sem isto, o sistema usa o
# host da propria requisicao, o que ja funciona em producao e em preview.
APP_URL=

# Pagamento online. Cifra as credenciais de gateway que cada pizzaria conecta
# pelo painel — sem ela, nenhum gateway pode ser ligado. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave torna ilegiveis as credenciais ja salvas: as pizzarias
# precisariam reconectar os gateways.
PAYMENTS_ENCRYPTION_KEY=

# Notificacao push. Gere o par com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A publica vai para o navegador; a privada fica so no servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br
